
-- Position Saver & Teleport Panel
-- LocalScript in StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local savedCFrame = nil
local autoTeleport = false

local gui = Instance.new("ScreenGui")
gui.Name = "PositionTeleportPanel"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(270, 230)
frame.Position = UDim2.new(0, 20, 0.4, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "Position Teleport"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.Parent = frame

local status = Instance.new("TextLabel")
status.Position = UDim2.fromOffset(10, 42)
status.Size = UDim2.new(1, -20, 0, 28)
status.BackgroundTransparency = 1
status.Text = "Keine Position gespeichert"
status.TextColor3 = Color3.fromRGB(200, 200, 200)
status.TextSize = 12
status.Parent = frame

local function makeButton(text, y, callback)
    local button = Instance.new("TextButton")
    button.Position = UDim2.fromOffset(15, y)
    button.Size = UDim2.new(1, -30, 0, 35)
    button.BackgroundColor3 = Color3.fromRGB(65, 100, 210)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.GothamSemibold
    button.Text = text
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 7)
    c.Parent = button

    button.Activated:Connect(callback)
    return button
end

local function getRoot()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

makeButton("Position speichern", 76, function()
    local root = getRoot()
    if not root then
        status.Text = "Figur nicht verfügbar"
        return
    end

    savedCFrame = root.CFrame
    status.Text = string.format(
        "Gespeichert: %.1f, %.1f, %.1f",
        savedCFrame.Position.X,
        savedCFrame.Position.Y,
        savedCFrame.Position.Z
    )
end)

makeButton("Zur Position teleportieren", 118, function()
    local root = getRoot()
    if not root or not savedCFrame then
        status.Text = "Erst eine Position speichern!"
        return
    end

    root.CFrame = savedCFrame
    status.Text = "Teleport ausgeführt"
end)

local autoButton
autoButton = makeButton("Auto-Teleport: AUS", 160, function()
    autoTeleport = not autoTeleport

    autoButton.Text = autoTeleport
        and "Auto-Teleport: AN"
        or "Auto-Teleport: AUS"

    autoButton.BackgroundColor3 = autoTeleport
        and Color3.fromRGB(40, 150, 85)
        or Color3.fromRGB(65, 100, 210)
end)

-- Teleport alle 0,5 Sekunden
task.spawn(function()
    while gui.Parent do
        task.wait(0.5)

        if autoTeleport and savedCFrame then
            local root = getRoot()
            if root then
                root.CFrame = savedCFrame
            end
        end
    end
end)

-- Einfaches Verschieben des Panels per Maus
local dragging = false
local dragStart, startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

title.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
