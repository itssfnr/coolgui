
-- Position Teleport Panel + Action History
-- LocalScript in StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local savedCFrame
local autoTeleport = false
local history = {}
local historyLimit = 8

local gui = Instance.new("ScreenGui")
gui.Name = "TeleportActionPanel"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(310, 390)
frame.Position = UDim2.new(0, 20, 0.25, 0)
frame.BackgroundColor3 = Color3.fromRGB(25, 27, 35)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 38)
title.Position = UDim2.fromOffset(10, 0)
title.BackgroundTransparency = 1
title.Text = "TELEPORT & AKTIONEN"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = frame

local status = Instance.new("TextLabel")
status.Position = UDim2.fromOffset(10, 38)
status.Size = UDim2.new(1, -20, 0, 30)
status.BackgroundTransparency = 1
status.Text = "Bereit"
status.TextColor3 = Color3.fromRGB(180, 200, 220)
status.TextSize = 12
status.Font = Enum.Font.Gotham
status.Parent = frame

local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function logAction(action, callback)
    table.insert(history, 1, {
        name = action,
        callback = callback,
        time = os.date("%H:%M:%S"),
    })

    while #history > historyLimit do
        table.remove(history)
    end

    status.Text = "Letzte Aktion: " .. action
end

local function button(text, y, callback)
    local b = Instance.new("TextButton")
    b.Position = UDim2.fromOffset(10, y)
    b.Size = UDim2.new(1, -20, 0, 32)
    b.BackgroundColor3 = Color3.fromRGB(65, 105, 220)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Text = text
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 12
    b.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = b

    b.Activated:Connect(callback)
    return b
end

local function savePosition()
    local root = getRoot()
    if not root then
        status.Text = "Figur nicht verfügbar"
        return
    end

    savedCFrame = root.CFrame
    logAction("Position gespeichert", savePosition)
end

local function teleport()
    local root = getRoot()
    if not root or not savedCFrame then
        status.Text = "Keine Position gespeichert"
        return
    end

    root.CFrame = savedCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    logAction("Teleport ausgeführt", teleport)
end

button("Position speichern", 72, savePosition)
button("Zur Position teleportieren", 110, teleport)

local autoButton
autoButton = button("Auto-Teleport: AUS", 148, function()
    autoTeleport = not autoTeleport
    autoButton.Text = autoTeleport
        and "Auto-Teleport: AN (0,1 s)"
        or "Auto-Teleport: AUS"

    logAction(
        autoTeleport and "Auto-Teleport aktiviert"
            or "Auto-Teleport deaktiviert",
        function()
            autoTeleport = true
            autoButton.Text = "Auto-Teleport: AN (0,1 s)"
        end
    )
end)

local historyTitle = Instance.new("TextLabel")
historyTitle.Position = UDim2.fromOffset(10, 187)
historyTitle.Size = UDim2.new(1, -20, 0, 24)
historyTitle.BackgroundTransparency = 1
historyTitle.Text = "AKTIONSVERLAUF"
historyTitle.TextColor3 = Color3.new(1, 1, 1)
historyTitle.Font = Enum.Font.GothamBold
historyTitle.TextSize = 12
historyTitle.TextXAlignment = Enum.TextXAlignment.Left
historyTitle.Parent = frame

local list = Instance.new("ScrollingFrame")
list.Position = UDim2.fromOffset(10, 213)
list.Size = UDim2.new(1, -20, 0, 165)
list.BackgroundColor3 = Color3.fromRGB(35, 38, 48)
list.BorderSizePixel = 0
list.ScrollBarThickness = 4
list.CanvasSize = UDim2.new()
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.Parent = frame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 5)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list

local function refreshHistory()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    for i, entry in ipairs(history) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -6, 0, 43)
        row.BackgroundColor3 = Color3.fromRGB(48, 52, 65)
        row.LayoutOrder = i
        row.Parent = list

        local label = Instance.new("TextLabel")
        label.Position = UDim2.fromOffset(6, 0)
        label.Size = UDim2.new(1, -85, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = entry.time .. "  " .. entry.name
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextSize = 10
        label.TextWrapped = true
        label.Font = Enum.Font.Gotham
        label.Parent = row

        local repeatButton = Instance.new("TextButton")
        repeatButton.Position = UDim2.new(1, -76, 0, 6)
        repeatButton.Size = UDim2.fromOffset(70, 31)
        repeatButton.BackgroundColor3 = Color3.fromRGB(35, 145, 85)
        repeatButton.Text = "WIEDERHOLEN"
        repeatButton.TextColor3 = Color3.new(1, 1, 1)
        repeatButton.TextSize = 9
        repeatButton.Font = Enum.Font.GothamBold
        repeatButton.Parent = row

        local savedEntry = entry
        repeatButton.Activated:Connect(function()
            if savedEntry.callback then
                savedEntry.callback()
            end
            refreshHistory()
        end)
    end
end

-- Protokoll nach jeder neuen Aktion aktualisieren.
local originalLogAction = logAction
logAction = function(action, callback)
    originalLogAction(action, callback)
    refreshHistory()
end

task.spawn(function()
    while gui.Parent do
        task.wait(0.1)

        if autoTeleport and savedCFrame then
            local root = getRoot()
            if root then
                root.CFrame = savedCFrame
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end)

-- Fenster verschieben
local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
